# Line-ending policy.
#
# Without this, every checkout on Windows produced "LF will be replaced by CRLF"
# warnings for all 50 tracked files. Store LF in the repository, check out
# native line endings, and force CRLF only for the file types Windows actually
# requires it for.

* text=auto

# These two carry no extension, so `* text=auto` alone left them at the mercy of
# core.autocrlf and every commit printed "LF will be replaced by CRLF" for them.
# Their contents are glob syntax, so pin them like the rest.
.gitattributes text eol=lf
.gitignore    text eol=lf

# Windows scripts and batch files must have CRLF, or they misbehave under cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Configuration and source that must not gain CR bytes.
*.rs   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.py   text eol=lf

# Binaries.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.jar  binary
*.exe  binary
*.dll  binary
*.pyc  binary
*.pyo  binary