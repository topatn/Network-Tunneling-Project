# Production Environment Configuration (T-104 / OPS-001)
# Intended for live production deployment. SECRETS MUST BE SUPPLIED VIA VAULT / HSM AT RUNTIME.
ENVIRONMENT=production
LOG_LEVEL=warn
CONTROL_PLANE_BIND=0.0.0.0:8443
DATABASE_URL=postgres://gtt_prod_app:placeholder_prod_db_secret@db.prod.internal:5432/gtt_production?sslmode=verify-full&sslrootcert=/etc/ssl/certs/prod-ca.pem
DATABASE_MAX_CONNECTIONS=50

# Relay cluster configuration
RELAY_ID=33333333-3333-4333-8333-333333333333
RELAY_REGION=prod-eu-west
RELAY_HOST=relay-eu-01.tunnel.example.com
RELAY_TUNNEL_PORT=4433
RELAY_PUBLIC_PORT_START=20000
RELAY_PUBLIC_PORT_END=40000
MAX_RELAY_ALLOCATIONS=250

# Signing key configuration (HSM / KMS-managed production key)
TOKEN_ISSUER=gtt-control-plane-production
ACTIVE_KEY_ID=prod-key-2026-10-a
SIGNING_KEY_SECRET=placeholder_production_hsm_managed_hmac_secret_32bytes_min

# WebAuthn and Admin configuration
ADMIN_RP_ID=admin.tunnel.example.com
ADMIN_ORIGIN=https://admin.tunnel.example.com
ADMIN_SESSION_TTL_SECS=900
ADMIN_STEP_UP_TTL_SECS=300
