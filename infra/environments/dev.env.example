# Development Environment Configuration (T-104 / OPS-001)
# Intended for local developer workstations.
ENVIRONMENT=development
LOG_LEVEL=debug
CONTROL_PLANE_BIND=127.0.0.1:8080
DATABASE_URL=postgres://gtt:gtt_dev_insecure_pass@localhost:5432/gtt_dev?sslmode=disable
DATABASE_MAX_CONNECTIONS=10

# Relay cluster configuration
RELAY_ID=11111111-1111-4111-8111-111111111111
RELAY_REGION=local-dev
RELAY_HOST=127.0.0.1
RELAY_TUNNEL_PORT=4433
RELAY_PUBLIC_PORT_START=20000
RELAY_PUBLIC_PORT_END=20100
MAX_RELAY_ALLOCATIONS=50

# Signing key configuration (dev key only)
TOKEN_ISSUER=gtt-control-plane-dev
ACTIVE_KEY_ID=dev-key-2026-10-a
SIGNING_KEY_SECRET=dev_insecure_signing_secret_do_not_use_in_prod_12345678

# WebAuthn and Admin configuration
ADMIN_RP_ID=admin.dev.tunnel.internal
ADMIN_ORIGIN=http://admin.dev.tunnel.internal:8080
ADMIN_SESSION_TTL_SECS=900
ADMIN_STEP_UP_TTL_SECS=300
