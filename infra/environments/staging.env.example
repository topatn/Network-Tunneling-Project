# Staging Environment Configuration (T-104 / OPS-001)
# Intended for pre-production CI/CD integration and staging cluster exercises.
ENVIRONMENT=staging
LOG_LEVEL=info
CONTROL_PLANE_BIND=0.0.0.0:8443
DATABASE_URL=postgres://gtt_staging_app:placeholder_staging_db_secret@db.staging.internal:5432/gtt_staging?sslmode=verify-full&sslrootcert=/etc/ssl/certs/staging-ca.pem
DATABASE_MAX_CONNECTIONS=25

# Relay cluster configuration
RELAY_ID=22222222-2222-4222-8222-222222222222
RELAY_REGION=staging-us-east
RELAY_HOST=relay.staging.tunnel.internal
RELAY_TUNNEL_PORT=4433
RELAY_PUBLIC_PORT_START=25000
RELAY_PUBLIC_PORT_END=26000
MAX_RELAY_ALLOCATIONS=100

# Signing key configuration (staging isolated key)
TOKEN_ISSUER=gtt-control-plane-staging
ACTIVE_KEY_ID=staging-key-2026-10-a
SIGNING_KEY_SECRET=placeholder_staging_vault_managed_hmac_secret_32bytes_min

# WebAuthn and Admin configuration
ADMIN_RP_ID=admin.staging.tunnel.internal
ADMIN_ORIGIN=https://admin.staging.tunnel.internal
ADMIN_SESSION_TTL_SECS=900
ADMIN_STEP_UP_TTL_SECS=300
