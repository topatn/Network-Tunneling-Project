{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtt.invalid/contracts/tunnel-hello.schema.json",
  "title": "TunnelHello",
  "description": "First control-stream message sent from engine to relay (contracts.md section 10).",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocol_version", "token", "client_version"],
  "properties": {
    "type": {
      "const": "hello"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
