{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtt.invalid/contracts/create-invitation-request.schema.json",
  "title": "CreateInvitationRequest",
  "description": "Request body for POST /v1/tunnels/{id}/invitations (contracts.md sections 5.11 and 15).",
  "type": "object",
  "additionalProperties": false,
  "required": ["expires_in_seconds", "max_claims"],
  "properties": {
    "expires_in_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 604800
    },
    "max_claims": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
