{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtt.invalid/contracts/tunnel.schema.json",
  "title": "Tunnel",
  "description": "Tunnel representation returned by /v1/tunnels routes (contracts.md sections 5.6, 5.7, 5.10 and data-model.md section 4). Contains no host-local target (INV-1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "game_profile_id",
    "profile_version",
    "state",
    "mappings",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "game_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": ["created", "active", "stopped", "terminated", "expired"]
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_key", "protocol", "position", "enabled"],
        "properties": {
          "mapping_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp"]
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "stopped_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "termination_reason": {
      "type": ["string", "null"],
      "maxLength": 64
    }
  }
}
