{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtt.invalid/contracts/tunnel-hello-ack.schema.json",
  "title": "TunnelHelloAck",
  "description": "Relay acknowledgment of engine hello defining session limits and data-path mapping indexes (contracts.md section 10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "session_id",
    "heartbeat_interval_ms",
    "idle_timeout_ms",
    "limits",
    "mappings"
  ],
  "properties": {
    "type": {
      "const": "hello_ack"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "heartbeat_interval_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "idle_timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tcp_flows", "max_udp_flows"],
      "properties": {
        "max_tcp_flows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_udp_flows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "mapping_key", "protocol", "public_port"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "mapping_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp"]
          },
          "public_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  }
}
