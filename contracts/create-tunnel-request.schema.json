{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtt.invalid/contracts/create-tunnel-request.schema.json",
  "title": "CreateTunnelRequest",
  "description": "Request body for POST /v1/tunnels (contracts.md sections 5.6 and 15). Rejects any local-target field (INV-1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "game_profile_id", "mappings"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "game_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_key", "protocol", "enabled"],
        "properties": {
          "mapping_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "protocol": {
            "type": "string",
            "enum": ["tcp", "udp"]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
