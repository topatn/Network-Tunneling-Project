{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtt.invalid/contracts/claim-invitation-response.schema.json",
  "title": "ClaimInvitationResponse",
  "description": "Response body for POST /v1/invitations/claim (contracts.md section 6) returning public relay host/ports for the stock game client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tunnel_id", "game_profile_id", "relay", "admitted_until"],
  "properties": {
    "tunnel_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "game_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "host", "ports"],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mapping_key", "protocol", "public_port"],
            "properties": {
              "mapping_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "protocol": {
                "type": "string",
                "enum": ["tcp", "udp"]
              },
              "public_port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    },
    "admitted_until": {
      "type": "string",
      "format": "date-time"
    }
  }
}
